{
  "name": "wiz-light-controller",
  "version": "2.0.0",
  "description": "Modular WiZ REST API controller",
  "main": "src/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maralexofficial/wiz-light-controller.git"
  },
  "keywords": [
    "wiz",
    "smart-home",
    "rest-api",
    "express",
    "pm2",
    "api-tokens"
  ],
  "license": "ISC",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "setup": "node scripts/setup.js",
    "test": "node tests/mac-normalization.js && node tests/migration-5.js",
    "test:migration-5": "node tests/migration-5.js",
    "test:mac": "node tests/mac-normalization.js",
    "wiz:sync": "node scripts/wiz-sync.js",
    "token:create": "node scripts/token.js create",
    "token:list": "node scripts/token.js list",
    "token:permissions": "node scripts/token.js permissions",
    "token:revoke": "node scripts/token.js revoke",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop wiz-light-controller",
    "pm2:restart": "pm2 restart wiz-light-controller",
    "pm2:logs": "pm2 logs wiz-light-controller",
    "pm2:status": "pm2 status",
    "pm2:delete": "pm2 delete wiz-light-controller"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pm2": "^6.0.0"
  }
}
